# OpenAI (ai-backend)
OPENAI_API_KEY=sk-...
# Supported for cost estimates: gpt-5.6-luna|terra|sol, gpt-5.4-mini, gpt-5.4-nano, gpt-5-nano
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium

# Runtime upload file for plan Run (repo-relative or absolute)
FILE_PATH=Letter.docx

# Optional
# AI_PORT=3848
# OPENAI_API_URL=https://api.openai.com/v1/responses
# OPENAI_TEMPERATURE=0.1
# OPENAI_MAX_OUTPUT_TOKENS=12000
# PROFILE_FILE_PATH=profile.md
# RUNTIME_FILE_KEY=runtime_file
